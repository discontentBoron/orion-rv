        }
        pin(dout0[19:0]){
        timing(){ 
            timing_sense : non_unate; 
            related_pin : "clk0"; 
            timing_type : falling_edge; 
            cell_rise(CELL_TABLE) {
            values("0.9, 0.914, 0.927",\
                   "0.902, 0.915, 0.928",\
                   "0.906, 0.92, 0.933",\
                   "0.912, 0.925, 0.938");
            }
